# Copy to scripts/dev.env (gitignored) and adjust if needed.
# cp scripts/dev.env.example scripts/dev.env

# remote | local — where docker compose / tests run
DEV_TARGET=remote

REMOTE_USER=root
REMOTE_HOST=alterserv.ru
REMOTE_PATH=/home/projects/pharm-client-app
SSH_KEY=~/.ssh/id_rsa

# rsync --chown (remote user must be allowed to chown)
RSYNC_CHOWN=root:root

# docker stack deploy name (swarm)
SWARM_STACK=pharmopt

# SSH tunnel local ports (for IDE debug / browser via localhost)
TUNNEL_DEBUG_PORT=5005
TUNNEL_BACKEND_PORT=8383
TUNNEL_FRONTEND_PORT=5173
